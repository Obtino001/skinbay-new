+++ b/sections/predictive-search.liquid
@@ -0,0 +1,112 @@
+{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
+{%- if predictive_search.performed -%}
+  {% assign first_column_results_size = predictive_search.resources.queries.size
+    | plus: predictive_search.resources.collections.size
+    | plus: predictive_search.resources.pages.size
+    | plus: predictive_search.resources.articles.size
+  %}
+  <div id="predictive-search-results" role="listbox">
+    {%- if first_column_results_size > 0 or predictive_search.resources.products.size > 0 -%}
+      <div
+        id="predictive-search-results-groups-wrapper"
+        class="predictive-search__results-groups-wrapper{% unless predictive_search.resources.products.size > 0 %} predictive-search__results-groups-wrapper--no-products{% endunless %}{% unless predictive_search.resources.queries.size > 0 or predictive_search.resources.collections.size > 0 %} predictive-search__results-groups-wrapper--no-suggestions{% endunless %}"
+      >
+        <div class="ds-predictive-queries">
+          <h2 class="ds-predictive-queries__heading">
+            Populære søgninger
+          </h2>
+          {%- if predictive_search.resources.queries.size > 0 or predictive_search.resources.collections.size > 0 -%}
+            <ul class="ds-predictive-queries__list" role="group">
+              {%- for query in predictive_search.resources.queries -%}
+                <li class="ds-predictive-queries__item">
+                  <a href="{{ query.url }}" class="ds-predictive-queries__link">
+                    <span class="ds-predictive-queries__left">
+                      <span class="ds-predictive-queries__icon" aria-hidden="true">
+                        <svg class="icon icon-search" width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
+                          <path d="M15.545 14.6625L17.9862 17.1025C18.1001 17.2204 18.1631 17.3783 18.1617 17.5421C18.1602 17.706 18.0945 17.8628 17.9786 17.9786C17.8628 18.0945 17.706 18.1602 17.5421 18.1617C17.3782 18.1631 17.2204 18.1001 17.1025 17.9863L14.6612 15.545C13.0659 16.9118 11.0033 17.6076 8.90601 17.4864C6.80877 17.3651 4.83999 16.4363 3.41281 14.8948C1.98562 13.3533 1.21097 11.3189 1.2514 9.21853C1.29183 7.11817 2.1442 5.11511 3.62965 3.62966C5.1151 2.14421 7.11817 1.29184 9.21852 1.25141C11.3189 1.21098 13.3533 1.98563 14.8948 3.41281C16.4363 4.84 17.3651 6.80878 17.4864 8.90602C17.6076 11.0033 16.9118 13.066 15.545 14.6613V14.6625ZM9.37499 16.25C11.1984 16.25 12.947 15.5257 14.2364 14.2364C15.5257 12.947 16.25 11.1984 16.25 9.375C16.25 7.55164 15.5257 5.80296 14.2364 4.51364C12.947 3.22433 11.1984 2.5 9.37499 2.5C7.55163 2.5 5.80295 3.22433 4.51364 4.51364C3.22432 5.80296 2.49999 7.55164 2.49999 9.375C2.49999 11.1984 3.22432 12.947 4.51364 14.2364C5.80295 15.5257 7.55163 16.25 9.37499 16.25Z" fill="currentColor"/>
+                        </svg>
+                      </span>
+                      <span>{{ query.text }}</span>
+                    </span>
+                    <span class="ds-predictive-queries__arrow" aria-hidden="true">
+                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
+                        <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
+                      </svg>
+                    </span>
+                  </a>
+                </li>
+              {%- endfor -%}
+              {%- for collection in predictive_search.resources.collections -%}
+                <li class="ds-predictive-queries__item">
+                  <a href="{{ collection.url }}" class="ds-predictive-queries__link">
+                    <span class="ds-predictive-queries__left">
+                      <span class="ds-predictive-queries__icon" aria-hidden="true">
+                        <svg class="icon icon-search" width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
+                          <path d="M15.545 14.6625L17.9862 17.1025C18.1001 17.2204 18.1631 17.3783 18.1617 17.5421C18.1602 17.706 18.0945 17.8628 17.9786 17.9786C17.8628 18.0945 17.706 18.1602 17.5421 18.1617C17.3782 18.1631 17.2204 18.1001 17.1025 17.9863L14.6612 15.545C13.0659 16.9118 11.0033 17.6076 8.90601 17.4864C6.80877 17.3651 4.83999 16.4363 3.41281 14.8948C1.98562 13.3533 1.21097 11.3189 1.2514 9.21853C1.29183 7.11817 2.1442 5.11511 3.62965 3.62966C5.1151 2.14421 7.11817 1.29184 9.21852 1.25141C11.3189 1.21098 13.3533 1.98563 14.8948 3.41281C16.4363 4.84 17.3651 6.80878 17.4864 8.90602C17.6076 11.0033 16.9118 13.066 15.545 14.6613V14.6625ZM9.37499 16.25C11.1984 16.25 12.947 15.5257 14.2364 14.2364C15.5257 12.947 16.25 11.1984 16.25 9.375C16.25 7.55164 15.5257 5.80296 14.2364 4.51364C12.947 3.22433 11.1984 2.5 9.37499 2.5C7.55163 2.5 5.80295 3.22433 4.51364 4.51364C3.22432 5.80296 2.49999 7.55164 2.49999 9.375C2.49999 11.1984 3.22432 12.947 4.51364 14.2364C5.80295 15.5257 7.55163 16.25 9.37499 16.25Z" fill="currentColor"/>
+                        </svg>
+                      </span>
+                      <span>{{ collection.title | escape }}</span>
+                    </span>
+                    <span class="ds-predictive-queries__arrow" aria-hidden="true">
+                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
+                        <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
+                      </svg>
+                    </span>
+                  </a>
+                </li>
+              {%- endfor -%}
+            </ul>
+          {%- else -%}
+            <p class="ds-predictive-no-queries">Ingen forslag</p>
+          {%- endif -%}
+        </div>
+
+        <div class="ds-predictive-products">
+          <div class="ds-predictive-products__header">
+            <h2 class="ds-predictive-products__heading">PRODUKTER</h2>
+            <a href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&type=product" class="ds-predictive-products__see-all">
+              SE FLERE
+            </a>
+          </div>
+
+          {%- if predictive_search.resources.products.size > 0 -%}
+            <div class="ds-predictive-products__grid">
+              {%- for product in predictive_search.resources.products limit: 4 -%}
+                <div class="ds-predictive-product-item">
+                  <a href="{{ product.url }}" class="ds-predictive-product-link">
+                    {%- if product.featured_media != blank -%}
+                      {{ product.featured_media | image_url: width: 300 | image_tag: class: 'ds-predictive-product-image', loading: 'lazy' }}
+                    {%- else -%}
+                      <div class="ds-predictive-product-image ds-predictive-placeholder"></div>
+                    {%- endif -%}
+                    <div class="ds-predictive-product-info">
+                      <span class="ds-predictive-product-title">{{ product.title }}</span>
+                      <div class="ds-predictive-product-price">
+                        {{ product.price | money }}
+                      </div>
+                    </div>
+                  </a>
+                </div>
+              {%- endfor -%}
+            </div>
+          {%- else -%}
+            <p class="ds-predictive-no-products">Ingen produkter fundet</p>
+          {%- endif -%}
+        </div>
+      </div>
+    {%- endif -%}
+  </div>
+
+  <span class="hidden" data-predictive-search-live-region-count-value>
+    {% liquid
+      assign total_results = predictive_search.resources.products.size | plus: first_column_results_size
+      if total_results == 0
+        echo 'templates.search.no_results' | t: terms: predictive_search.terms
+      else
+        echo 'templates.search.results_with_count' | t: count: total_results
+      endif
+    %}
+  </span>
+{%- endif -%}
+
