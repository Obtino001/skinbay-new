+    document.querySelectorAll('.mega-menu--brands').forEach(function(panel){
+      var flyout = panel.querySelector('.brands-flyout');
+      var ranges = panel.querySelectorAll('.brand-ranges');
+      var links  = panel.querySelectorAll('.brand-mega-link.has-ranges');
+      if(!flyout || !ranges.length) return;
+      function activate(b){
+        var found=false;
+        ranges.forEach(function(r){ var on=(r.getAttribute('data-brand')===b); r.classList.toggle('is-active',on); if(on) found=true; });
+        flyout.classList.toggle('has-active',found);
+      }
+      var _best=ranges[0], _bn=-1;
+      ranges.forEach(function(r){ var n=r.querySelectorAll('.brand-ranges__link').length; if(n>_bn){_bn=n;_best=r;} });
+      activate(_best.getAttribute('data-brand'));
+      links.forEach(function(a){
+        a.addEventListener('mouseenter',function(){ activate(a.getAttribute('data-brand')); });
+        a.addEventListener('focus',function(){ activate(a.getAttribute('data-brand')); });
+      });
+    });
+  })();
+
+  // Intercept ALL native /cart/add.js calls (Horizon PDP ATC, app widgets, etc.)
+  // so they open our custom cart drawer instead of Horizon's built-in cart UI.
+  (function() {
+    var _origFetch = window.fetch;
+    window.fetch = function(input, init) {
+      var url = typeof input === 'string' ? input : (input && input.url) || '';
+      var method = (init && init.method || 'GET').toUpperCase();
+      if (url.includes('/cart/add') && method === 'POST') {
+        return _origFetch.apply(this, arguments).then(function(resp) {
+          if (resp.ok) {
+            setTimeout(function() {
+              document.dispatchEvent(new CustomEvent('cart:refresh'));
+            }, 150);
+          }
+          return resp;
+        });
+      }
+      return _origFetch.apply(this, arguments);
+    };
+  })();
+</script>
 
