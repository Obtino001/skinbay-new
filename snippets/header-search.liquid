{% comment %}
  Renders a header search dropdown with predictive search.

  Accepts:
  - input_id: {String} Id for the search input element (required)
  - section: {Object} Header section (for search settings & blocks)

  Usage:
  {% render 'header-search', input_id: 'Search-In-Modal', section: section %}
{% endcomment %}

{%- liquid
  assign search_placeholder = section.settings.search_placeholder | default: 'Search products'
  assign popular_searches_heading = section.settings.popular_searches_heading | default: 'Popular Searches'
  assign popular_brands_heading = section.settings.popular_brands_heading | default: 'Popular Brands'
  assign popular_blogs_heading = section.settings.popular_blogs_heading | default: 'Popular Blogs'
  assign trending_heading = section.settings.trending_heading | default: 'Trending'

  assign popular_searches_menu = blank
  assign popular_brands_menu = blank
  assign popular_blogs_menu = blank
  assign skip_searches_menu = false
  assign skip_brands_menu = false

  if section.settings.popular_searches_menu != blank
    assign popular_searches_menu = linklists[section.settings.popular_searches_menu]
    if section.settings.popular_searches_menu == 'main-menu' or section.settings.popular_searches_menu == 'my-skinbay'
      assign skip_searches_menu = true
    endif
  endif
  if section.settings.popular_brands_menu != blank
    assign popular_brands_menu = linklists[section.settings.popular_brands_menu]
    if section.settings.popular_brands_menu == 'main-menu' or section.settings.popular_brands_menu == 'my-skinbay'
      assign skip_brands_menu = true
    endif
  endif
  if section.settings.popular_blogs_menu != blank
    assign popular_blogs_menu = linklists[section.settings.popular_blogs_menu]
  endif

  assign trending_collections = section.settings.trending_collections
  assign default_search_terms = 'Vitamin C|Retinol|Hyaluronic Acid|SPF|Pigmentation|Barrier Repair' | split: '|'
-%}

<details-modal class="header__search ds-header-search">
  <details>
    <summary
      class="header__icon header__icon--search header__icon--summary link focus-inset modal__toggle lf-search-trigger"
      aria-haspopup="dialog"
      aria-label="{{ 'content.search' | t }}"
    >
      <span class="lf-search-trigger__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      </span>
      <span class="lf-search-trigger__placeholder">{{ search_placeholder }}</span>
    </summary>

    <div class="modal-overlay"></div>

    <div
      class="ds-search-panel"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'content.search' | t }}"
    >
      <div class="ds-search-panel__inner" tabindex="-1">
        <predictive-search class="ds-search-panel__predictive" data-loading-text="{{ 'accessibility.loading' | t }}">
          <form action="{{ routes.search_url }}" method="get" role="search" class="ds-search-form">
            <div class="ds-search-form__field">
              <span class="ds-search-form__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
              </span>
              <input
                id="{{ input_id }}"
                class="ds-search-form__input"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="{{ search_placeholder | escape }}"
                role="combobox"
                aria-expanded="false"
                aria-owns="predictive-search-results"
                aria-controls="predictive-search-results"
                aria-haspopup="listbox"
                aria-autocomplete="list"
                autocorrect="off"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              >
              <input type="hidden" name="options[prefix]" value="last">
              <button type="submit" class="visually-hidden">
                {{ 'content.search' | t }}
              </button>
              <button
                type="reset"
                class="ds-search-form__reset visually-hidden"
                aria-label="{{ 'accessibility.reset_search' | t }}"
                tabindex="-1"
              >
                {{ 'actions.clear' | t }}
              </button>
            </div>

            <button type="button" class="ds-search-form__close" aria-label="{{ 'accessibility.close_dialog' | t }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
          </form>

          <div
            class="predictive-search predictive-search--header ds-search-results"
            tabindex="-1"
            data-predictive-search
          >
            <div class="predictive-search__loading-state" role="status">
              <span class="ds-search-spinner" aria-hidden="true"></span>
              <span class="visually-hidden">{{ 'accessibility.loading' | t }}</span>
            </div>
          </div>
          <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>

          <div class="ds-search-discovery" data-ds-search-discovery>
            <div class="ds-search-discovery__grid">
              <div class="ds-search-discovery__left">
                <div class="ds-search-group">
                  <div class="ds-search-group__heading">
                    <h4>{{ popular_searches_heading }}</h4>
                    <span class="ds-search-group__line"></span>
                  </div>
                  <ul class="ds-search-group__list list-unstyled">
                    {%- if skip_searches_menu == false and popular_searches_menu != blank and popular_searches_menu.links.size > 0 -%}
                      {%- for link in popular_searches_menu.links -%}
                        <li>
                          <a href="{{ link.url }}" class="ds-search-link ds-search-link--search">
                            <span class="ds-search-link__left">
                              <span class="ds-search-link__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                              </span>
                              <span class="ds-search-link__label">{{ link.title }}</span>
                            </span>
                            <span class="ds-search-link__arrow" aria-hidden="true">
                              <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </span>
                          </a>
                        </li>
                      {%- endfor -%}
                    {%- else -%}
                      {%- for term in default_search_terms -%}
                        <li>
                          <a href="{{ routes.search_url }}?q={{ term | url_encode }}" class="ds-search-link ds-search-link--search">
                            <span class="ds-search-link__left">
                              <span class="ds-search-link__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                              </span>
                              <span class="ds-search-link__label">{{ term }}</span>
                            </span>
                            <span class="ds-search-link__arrow" aria-hidden="true">
                              <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </span>
                          </a>
                        </li>
                      {%- endfor -%}
                    {%- endif -%}
                  </ul>
                </div>

                <div class="ds-search-group">
                  <div class="ds-search-group__heading">
                    <h4>{{ popular_brands_heading }}</h4>
                    <span class="ds-search-group__line"></span>
                  </div>
                  <ul class="ds-search-group__list list-unstyled">
                    {%- if skip_brands_menu == false and popular_brands_menu != blank and popular_brands_menu.links.size > 0 -%}
                      {%- for link in popular_brands_menu.links -%}
                        <li>
                          <a href="{{ link.url }}" class="ds-search-link">
                            <span class="ds-search-link__left">
                              <span class="ds-search-link__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 9h8M8 13h5"/></svg>
                              </span>
                              <span class="ds-search-link__label">{{ link.title }}</span>
                            </span>
                          </a>
                        </li>
                      {%- endfor -%}
                    {%- else -%}
                      <li>
                        <a href="/collections/skinceuticals" class="ds-search-link">
                          <span class="ds-search-link__left">
                            <span class="ds-search-link__icon" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 9h8M8 13h5"/></svg>
                            </span>
                            <span class="ds-search-link__label">SkinCeuticals</span>
                          </span>
                        </a>
                      </li>
                      <li>
                        <a href="/collections/cliniccare" class="ds-search-link">
                          <span class="ds-search-link__left">
                            <span class="ds-search-link__icon" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 9h8M8 13h5"/></svg>
                            </span>
                            <span class="ds-search-link__label">ClinicCare</span>
                          </span>
                        </a>
                      </li>
                      <li>
                        <a href="/collections/medik8" class="ds-search-link">
                          <span class="ds-search-link__left">
                            <span class="ds-search-link__icon" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 9h8M8 13h5"/></svg>
                            </span>
                            <span class="ds-search-link__label">Medik8</span>
                          </span>
                        </a>
                      </li>
                      <li>
                        <a href="/collections/heliocare" class="ds-search-link">
                          <span class="ds-search-link__left">
                            <span class="ds-search-link__icon" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 9h8M8 13h5"/></svg>
                            </span>
                            <span class="ds-search-link__label">Heliocare</span>
                          </span>
                        </a>
                      </li>
                      <li>
                        <a href="/collections/nad-at-home" class="ds-search-link">
                          <span class="ds-search-link__left">
                            <span class="ds-search-link__icon" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 9h8M8 13h5"/></svg>
                            </span>
                            <span class="ds-search-link__label">NAD+ at Home</span>
                          </span>
                        </a>
                      </li>
                    {%- endif -%}
                  </ul>
                </div>

                {%- if popular_blogs_menu != blank and popular_blogs_menu.links.size > 0 -%}
                  <div class="ds-search-group">
                    <div class="ds-search-group__heading">
                      <h4>{{ popular_blogs_heading }}</h4>
                      <span class="ds-search-group__line"></span>
                    </div>
                    <ul class="ds-search-group__list list-unstyled">
                      {%- for link in popular_blogs_menu.links -%}
                        <li>
                          <a href="{{ link.url }}" class="ds-search-link">
                            <span class="ds-search-link__left">
                              <span class="ds-search-link__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5h14v14H5z"/><path d="M8 9h8M8 13h6"/></svg>
                              </span>
                              <span class="ds-search-link__label ds-search-link__label--truncate">
                                {{- link.title -}}
                              </span>
                            </span>
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
              </div>

              <div class="ds-search-discovery__right">
                <div class="ds-search-group__heading">
                  <h4>{{ trending_heading }}</h4>
                  <span class="ds-search-group__line"></span>
                </div>

                <div class="ds-trending-slider" data-ds-trending-slider>
                  <div class="ds-trending-slider__track" data-ds-trending-track>
                    {%- if trending_collections != blank and trending_collections.size > 0 -%}
                      {%- for col in trending_collections -%}
                        {%- liquid
                          assign trending_img = col.featured_image
                          if trending_img == blank
                            assign trending_img = col.image
                          endif
                        -%}
                        <div class="ds-trending-slide">
                          <a class="ds-trending-card" href="{{ col.url }}">
                            <div class="ds-trending-card__thumb">
                              {%- if trending_img != blank -%}
                                {{
                                  trending_img
                                  | image_url: width: 658
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '200, 300, 400, 658',
                                    sizes: '(min-width: 990px) 186px, 40vw',
                                    alt: col.title
                                }}
                              {%- else -%}
                                {{ 'collection-1' | placeholder_svg_tag: 'ds-trending-card__placeholder' }}
                              {%- endif -%}
                            </div>
                            <span class="ds-trending-card__label">{{ col.title }}</span>
                          </a>
                        </div>
                      {%- endfor -%}
                    {%- else -%}
                      {%- for i in (1..4) -%}
                        {%- liquid
                          assign img_key = 'trending_' | append: i | append: '_image'
                          assign title_key = 'trending_' | append: i | append: '_title'
                          assign link_key = 'trending_' | append: i | append: '_link'

                          assign card_img = settings[img_key] | default: section.settings[img_key]
                          assign card_title = settings[title_key] | default: section.settings[title_key]
                          assign card_link = settings[link_key] | default: section.settings[link_key]

                          case i
                            when 1
                              if card_title == blank
                                assign card_title = 'Find your routine'
                              endif
                            when 2
                              if card_title == blank
                                assign card_title = 'Hair Care'
                              endif
                            when 3
                              if card_title == blank
                                assign card_title = 'Bestsellers'
                              endif
                            when 4
                              if card_title == blank
                                assign card_title = 'Body Care'
                              endif
                          endcase
                        -%}
                        <div class="ds-trending-slide">
                          <a
                            class="ds-trending-card"
                            href="{{ card_link | default: '#' }}"
                            {% if card_link == blank %}
                              aria-disabled="true"
                            {% endif %}
                          >
                            <div class="ds-trending-card__thumb">
                              {%- if card_img != blank -%}
                                {{
                                  card_img
                                  | image_url: width: 658
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '200, 300, 400, 658',
                                    sizes: '(min-width: 990px) 186px, 40vw',
                                    alt: card_title
                                }}
                              {%- else -%}
                                {%- assign placeholder_name = 'collection-' | append: i -%}
                                {{ placeholder_name | placeholder_svg_tag: 'ds-trending-card__placeholder' }}
                              {%- endif -%}
                            </div>
                            {%- if card_title != blank -%}
                              <span class="ds-trending-card__label">{{ card_title }}</span>
                            {%- endif -%}
                          </a>
                        </div>
                      {%- endfor -%}
                    {%- endif -%}
                  </div>
                  <div class="ds-trending-slider__dots" data-ds-trending-dots hidden></div>
                </div>
              </div>
            </div>
          </div>
        </predictive-search>
      </div>
    </div>
  </details>
</details-modal>
