{%- assign g1 = section.settings.bg1 | default: '#E9E4D8' -%}
{%- assign ink = section.settings.gold | default: '#1a1a1a' -%}
{%- assign link = section.settings.cta_link | default: '/pages/skinbay-loyalty-rewards' -%}
{%- if section.settings.heading_image != blank -%}{%- assign bp_head = section.settings.heading_image | image_url: width: 900 -%}{%- else -%}{%- assign bp_head = 'baypoints-benefits-title.png' | asset_url -%}{%- endif -%}
<style>
.sbbp-{{ section.id }}{ background:{{ g1 }}; padding:46px 24px; font-family:'Lato',Helvetica,Arial,sans-serif; text-align:center; position:relative; }
.sbbp-{{ section.id }} .in{ max-width:640px; margin:0 auto; display:flex; flex-direction:column; align-items:center; gap:16px; }
.sbbp-{{ section.id }} .ey{ font-size:12px; font-weight:700; letter-spacing:.32em; text-transform:uppercase; color:{{ ink }}; }
.sbbp-{{ section.id }} .head-img{ width:min(440px,84%); height:auto; display:block; }
.sbbp-{{ section.id }} .vh{ position:absolute!important; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }
.sbbp-{{ section.id }} .benefits{ display:flex; flex-direction:column; gap:5px; font-size:16px; line-height:1.5; color:{{ ink }}; }
.sbbp-{{ section.id }} .benefits strong{ font-weight:700; }
.sbbp-{{ section.id }} .benefits .muted{ opacity:.82; }
.sbbp-{{ section.id }} .cta{ display:inline-block; background:{{ ink }}; color:#fff; text-decoration:none; font-size:12px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; padding:15px 36px; border-radius:40px; margin-top:8px; transition:filter .15s ease, transform .15s ease; }
.sbbp-{{ section.id }} .cta:hover{ filter:brightness(1.35); transform:translateY(-1px); }
.sbbp-{{ section.id }} .corner{ position:absolute; font-size:9px; color:{{ ink }}; opacity:.38; }
.sbbp-{{ section.id }} .c1{ top:20px; left:24px; } .sbbp-{{ section.id }} .c2{ top:20px; right:24px; } .sbbp-{{ section.id }} .c3{ bottom:20px; left:24px; } .sbbp-{{ section.id }} .c4{ bottom:20px; right:24px; }
@media (max-width:600px){ .sbbp-{{ section.id }}{ padding:38px 20px; } .sbbp-{{ section.id }} .benefits{ font-size:15px; } }
</style>
<div class="sbbp-{{ section.id }}">
  <span class="corner c1" aria-hidden="true">&#10022;</span><span class="corner c2" aria-hidden="true">&#10022;</span><span class="corner c3" aria-hidden="true">&#10022;</span><span class="corner c4" aria-hidden="true">&#10022;</span>
  <div class="in">
    <span class="ey">{{ section.settings.eyebrow | default: 'Rewards' }}</span>
    <img class="head-img" src="{{ bp_head }}" alt="Discover BayPoints, The Benefits" loading="lazy">
    <h2 class="vh">Discover BayPoints, The Benefits</h2>
    <div class="benefits">
      <p><strong>Earn 1 point</strong> for every &pound;2 you spend</p>
      <p><strong>Collect 100 points</strong> for a &pound;5 voucher</p>
      <p class="muted">Exclusive offers &amp; rewards, just for you</p>
    </div>
    <a class="cta" href="{{ link }}">{{ section.settings.cta_text | default: 'Join BayPoints Now' }}</a>
  </div>
</div>
{% schema %}
{
  "name": "BayPoints Rewards",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Rewards" },
    { "type": "image_picker", "id": "heading_image", "label": "Heading graphic (blank = default)" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Join BayPoints Now" },
    { "type": "url", "id": "cta_link", "label": "Button link (defaults to rewards page)" },
    { "type": "color", "id": "bg1", "label": "Background", "default": "#E9E4D8" },
    { "type": "color", "id": "bg2", "label": "Background 2 (unused)", "default": "#E9E4D8" },
    { "type": "color", "id": "gold", "label": "Text / ink colour", "default": "#1a1a1a" }
  ],
  "presets": [{ "name": "BayPoints Rewards" }]
}
{% endschema %}