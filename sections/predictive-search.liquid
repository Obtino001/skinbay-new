{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{%- if predictive_search.performed -%}
  {%- liquid
    assign queries_count = predictive_search.resources.queries.size
    assign collections_count = predictive_search.resources.collections.size
    assign products_count = predictive_search.resources.products.size
    assign total_results = products_count | plus: queries_count | plus: collections_count | plus: predictive_search.resources.pages.size | plus: predictive_search.resources.articles.size
  -%}
  <div id="predictive-search-results" role="listbox">
    {%- if total_results > 0 -%}
      <div
        id="predictive-search-results-groups-wrapper"
        class="predictive-search__results-groups-wrapper{% unless products_count > 0 %} predictive-search__results-groups-wrapper--no-products{% endunless %}{% unless queries_count > 0 or collections_count > 0 %} predictive-search__results-groups-wrapper--no-suggestions{% endunless %}"
      >
        <div class="ds-predictive-queries">
          <h2 class="ds-predictive-queries__heading">
            {{ 'content.search_results_resource_queries' | t }}
          </h2>
          {%- if queries_count > 0 or collections_count > 0 -%}
            <ul class="ds-predictive-queries__list" role="group" aria-label="{{ 'content.search_results_resource_queries' | t }}">
              {%- for query in predictive_search.resources.queries -%}
                <li class="ds-predictive-queries__item" id="predictive-search-option-query-{{ forloop.index }}" aria-selected="false">
                  <a href="{{ query.url }}" class="ds-predictive-queries__link">
                    <span class="ds-predictive-queries__left">
                      <span class="ds-predictive-queries__icon" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                      </span>
                      <span>{{ query.text }}</span>
                    </span>
                    <span class="ds-predictive-queries__arrow" aria-hidden="true">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </a>
                </li>
              {%- endfor -%}
              {%- for collection in predictive_search.resources.collections -%}
                <li class="ds-predictive-queries__item" id="predictive-search-option-collection-{{ forloop.index }}" aria-selected="false">
                  <a href="{{ collection.url }}" class="ds-predictive-queries__link">
                    <span class="ds-predictive-queries__left">
                      <span class="ds-predictive-queries__icon" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 9h8M8 13h5"/></svg>
                      </span>
                      <span>{{ collection.title | escape }}</span>
                    </span>
                    <span class="ds-predictive-queries__arrow" aria-hidden="true">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <p class="ds-predictive-no-queries">{{ 'content.no_suggestions' | t }}</p>
          {%- endif -%}
        </div>

        <div class="ds-predictive-products">
          <div class="ds-predictive-products__header">
            <h2 class="ds-predictive-products__heading">{{ 'content.search_results_resource_products' | t }}</h2>
            <a href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}" class="ds-predictive-products__see-all">
              {{ 'content.search_results_view_all' | t }}
            </a>
          </div>

          {%- if products_count > 0 -%}
            <div class="ds-predictive-products__grid">
              {%- for product in predictive_search.resources.products limit: 4 -%}
                <div class="ds-predictive-product-item" id="predictive-search-option-product-{{ forloop.index }}" aria-selected="false">
                  <a href="{{ product.url }}" class="ds-predictive-product-link">
                    {%- if product.featured_media != blank -%}
                      {{ product.featured_media | image_url: width: 300 | image_tag: class: 'ds-predictive-product-image', loading: 'lazy', alt: product.title }}
                    {%- else -%}
                      <div class="ds-predictive-product-image ds-predictive-placeholder"></div>
                    {%- endif -%}
                    <div class="ds-predictive-product-info">
                      <span class="ds-predictive-product-title">{{ product.title | escape }}</span>
                      <div class="ds-predictive-product-price">
                        {{ product.price | money }}
                      </div>
                    </div>
                  </a>
                </div>
              {%- endfor -%}
            </div>
          {%- else -%}
            <p class="ds-predictive-no-products">{{ 'content.no_products_found' | t }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- else -%}
      <div class="ds-predictive-empty">
        <p class="ds-predictive-no-results">
          {{ 'content.search_results_no_results' | t: terms: predictive_search.terms }}
        </p>
        <a class="ds-predictive-search-for" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}">
          {{ 'content.search_results_view_all' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>

  <span class="visually-hidden" data-predictive-search-live-region-count-value>
    {%- if total_results == 0 -%}
      {{ 'content.search_results_no_results' | t: terms: predictive_search.terms }}
    {%- else -%}
      {{ 'accessibility.search_results_count' | t: count: total_results, query: predictive_search.terms }}
    {%- endif -%}
  </span>
{%- endif -%}
